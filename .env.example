# Copy to .env.local and fill in. .env.local is gitignored.

# Resend — contact form email delivery
RESEND_API_KEY=
OWNER_EMAIL=owner@handlyr.org

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Google reviews widget (Places API New)
# 1. Google Cloud Console → enable "Places API (New)" → create an API key.
# 2. Find the Place ID for the business (Place ID Finder or the Places API).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
